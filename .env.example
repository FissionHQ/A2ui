# A2UI Adaptive Experience Engine
# Setup (recorded from developer interview):
#   LLM provider: Google Gemini
#   Model requested: AntiGravity (agent id antigravity-preview-05-2026)
#   Structured generation model: gemini-3.6-flash (Antigravity default underlying model)
#   API key file: .env.local
#   Experiences: ALL
#   Data: mix (real free APIs when available, otherwise mock)
#   Run: Docker
#
# Copy this file:
#   cp .env.example .env.local
#
# Then set LLM_API_KEY (Gemini API key from https://aistudio.google.com/apikey).
# Never put secrets in frontend code. The browser never sees this file.

LLM_PROVIDER=gemini
# Alias / managed agent id requested at setup. Used for labeling.
LLM_MODEL=antigravity-preview-05-2026
# Actual Gemini generateContent model for A2UI JSON (Antigravity is a managed
# coding/sandbox agent; structured UI generation uses its default Gemini model).
GEMINI_GENERATION_MODEL=gemini-3.6-flash
LLM_API_KEY=
LLM_BASE_URL=

WEATHER_API_KEY=
NEWS_API_KEY=
MARKET_API_KEY=

# mix = live free APIs (Open-Meteo, HN Algolia, Yahoo chart) with mock fallback
DATA_MODE=mix
ENABLED_DOMAINS=WEATHER,NEWS,TRAVEL,MARKET_DATA,SHOPPING,FINTECH,CUSTOMER_SUPPORT

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:80
